# Copy to .env and adjust. Values are configuration defaults, not claims about
# market purchasing rules.

ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1

DATABASE_URL=sqlite:///./data/app.db

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO

BUSINESS_TIMEZONE=Europe/London

DEFAULT_ANALYSIS_WINDOW_DAYS=28

FORECAST_PUBLICATION_LOOKBACK_DAYS=7

# Required for historical accuracy: HH:MM on the day before delivery, e.g. 09:00.
# Left blank deliberately - this is the buyer's business decision.
DECISION_CUTOFF_TIME=
DECISION_CUTOFF_TIMEZONE=Europe/London

# Optional tuning (defaults shown)
# FORECAST_ALIGNMENT_METHOD=hourly_mean      # or start_period
# MIN_SAMPLES_FOR_ERROR_RANGE=30
# ERROR_RANGE_LEVEL_BANDS=5
# MIN_DAYS_FOR_DAILY_ENERGY_RANGE=20
# DEFAULT_HISTOGRAM_BINS=20
# ELEXON_TIMEOUT_SECONDS=30
# ELEXON_MAX_RETRIES=3
# ELEXON_BACKOFF_BASE_SECONDS=0.5
# ELEXON_MAX_RETRY_AFTER_SECONDS=60
# ELEXON_FUELHH_CHUNK_DAYS=14
# ELEXON_WINDFOR_CHUNK_DAYS=7
